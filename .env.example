# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, local testing only: Splitwise API key (https://secure.splitwise.com/apps → Register your application).
# No VITE_ prefix on purpose — it stays in the dev server and is never put into the app.
SPLITWISE_API_KEY=
