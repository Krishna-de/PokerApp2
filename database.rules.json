{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": true,
      ".write": "auth != null && auth.provider != 'anonymous'",
      ".indexOn": ["phase"]
    },
    "roomPins": {
      "$roomId": {
        ".read": "auth != null && auth.provider != 'anonymous'",
        ".write": "auth != null && auth.provider != 'anonymous'"
      }
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
